# Template para o .env da raiz (usado pelo docker-compose.yml).
# Copia para .env e preenche. O .env NUNCA deve ser commitado.

# Base de dados
POSTGRES_DB=fittraining
POSTGRES_USER=fittraining_user
POSTGRES_PASSWORD=

# Segredo de assinatura dos JWT.
# Gera um novo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Porta em que a app escuta (host e container)
PORT=8510

# Chave da API Pollinations.ai
POLLINATIONS_API_KEY=

# Origens permitidas para pedidos cross-origin (separadas por vírgula)
CORS_ORIGINS=https://magnific1.ddns.net,http://localhost:5173
